{
  "manifest_version": 3,
  "name": "Fodder Flow",
  "version": "1.5.2",
  "description": "Automation tool for SBC solving in the FC26 Web App",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AutopilotSBC",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "scripting", "alarms", "tabs"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://www.ea.com/*",
    "https://www.fut.gg/*",
    "https://fodderflowggfc.vercel.app/*",
    "https://fodderflow.shant0.xyz/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content-script.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page/ea-data-bridge.js",
        "page/ea-data-bridge.css",
        "icons/fodder-flow-logo.png",
        "data/changelog.json",
        "solver/solver.js",
        "solver/chemistry.js",
        "solver/constraint-compiler.js",
        "solver/worker.js",
        "solver/local-ai.js",
        "solver/glpk.js",
        "solver/glpk.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
